APP_NAME=SIMMAG
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simmag
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=example_session
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false


# auto supports HTTP local and adds Secure automatically behind trusted HTTPS proxy.
SESSION_SECURE_COOKIE=null
SESSION_DOMAIN=
# Comma-separated IPs of actual reverse proxies, e.g. 127.0.0.1,::1 for local HTTPS.
TRUSTED_PROXIES=
# Exact hosts or wildcard suffixes accepted after trusted proxy processing.
GATEWAY_TRUSTED_HOSTS=localhost,127.0.0.1,smkn1cerme.test,*.smkn1cerme.test,*.ngrok-free.app,*.ngrok.app,*.trycloudflare.com
GATEWAY_ALLOWED_PREFIXES=/,/simmag
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=debug
# Absolute path to LibreOffice soffice.exe / soffice for uploaded certificate DOCX.
# Debian example (confirm with `command -v soffice`): /usr/bin/soffice
# Windows example: C:/Program Files/LibreOffice/program/soffice.exe
# Built-in and decorated PDF layouts work without this optional server dependency.
CERTIFICATE_LIBREOFFICE=
