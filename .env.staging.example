APP_NAME=SIMMAG
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.simmag.example.sch.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simmag_staging
DB_USERNAME=simmag_staging
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=simmag_staging_session
SESSION_SECURE_COOKIE=auto
SESSION_DOMAIN=
# Isi hanya bila TLS berakhir di reverse proxy. Gunakan IP proxy yang sebenarnya, jangan *.
TRUSTED_PROXIES=
# Tambahkan suffix tunnel yang digunakan sebagai wildcard; jangan menulis hostname acak di source.
GATEWAY_TRUSTED_HOSTS=smkn1cerme.test,*.smkn1cerme.test,*.ngrok-free.app,*.ngrok.app,*.trycloudflare.com
GATEWAY_ALLOWED_PREFIXES=/,/simmag

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=info

# Opsional. PDF bawaan/dekorasi tidak membutuhkan LibreOffice.
CERTIFICATE_LIBREOFFICE=

